+
+    def _fmt(v):
+        return [round(float(x), 3) for x in v]
+
+    def _probe_palm_axes():
+        q = _robot.data.body_quat_w[0:1, _palm_bid, :]
+        R = _mfq(q)[0]  # [3,3], columns are local X/Y/Z axes in world frame
